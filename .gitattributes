# The site is generated on Windows but served from Linux. Normalise to LF in
# the repository so a rebuild does not show every file as modified, and so the
# checkout stops warning about it on every commit.
* text=auto eol=lf

*.webp binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.mp4  binary
*.webm binary
*.woff2 binary
*.exe  binary
*.apk  binary

# Generated bundles contain vendor shader/template strings with significant
# formatting. Keep whitespace checks on the editable source instead.
assets/scene.js -whitespace
assets/explainer.js -whitespace
